#!/bin/sh
# isongwrt —— sing-box 内核管理与配置控制后端（LuCI 前端通过 fs.exec 调用）
# 依赖：OpenWrt 基础组件（uci / tar / busybox；下载走 curl 或系统自带 uclient-fetch/wget）
# 内核来源：一律取自官方 Releases（SagerNet/sing-box），按架构自动匹配并优先 musl 构建；
#          本项目不编译内核（CI 只构建 LuCI 包）。
# 用法：ctl <status|channels|releases|installed|install|rollback|remove|config-*> ...
set -u

APP=isongwrt
STATE_DIR=/etc/isongwrt
INSTALL_DIR="$STATE_DIR/installed"
BACKUP_DIR="$STATE_DIR/backups"
CONF_DIR_DEFAULT="$STATE_DIR/conf"
ACTIVE_FILE="$STATE_DIR/active"
CACHE_DIR=/tmp/isongwrt-cache
STATE_CACHE="$STATE_DIR/cache"          # 持久缓存（版本列表，重启后仍可用于展示）
ATOM_CACHE="$STATE_CACHE/releases.atom"
GH_REPO=SagerNet/sing-box
GH_API="https://api.github.com/repos/$GH_REPO/releases"
UA="isongwrt/0.1.0"

cfg()  { uci -q get "isongwrt.main.$1" 2>/dev/null; }
cfgd() { _v=$(cfg "$1"); [ -n "${_v:-}" ] && printf '%s' "$_v" || printf '%s' "$2"; }
json_esc() { printf '%s' "$1" | sed -e 's/\\/\\\\/g' -e 's/"/\\"/g' -e 's/\t/\\t/g'; }
json_ml()  { awk '{ gsub(/\\/,"\\\\"); gsub(/"/,"\\\""); gsub(/\t/,"\\t"); printf "%s\\n", $0 }' | sed -e 's/\\n$//'; }
die() { printf '{"ok":false,"error":"%s"}\n' "$(json_esc "$1")" >&2; exit 1; }
ok()  { printf '{"ok":true%s}\n' "${1:-}"; }

CORE_PATH=$(cfgd core_path /usr/lib/isongwrt/sing-box)
CONF_DIR=$(cfgd conf_dir "$CONF_DIR_DEFAULT")
WORK_DIR=$(cfgd work_dir "$STATE_DIR")
CHANNEL=$(cfgd channel stable)
GH_PROXY=$(cfgd github_proxy '')
API_LISTEN=$(cfgd api_listen 127.0.0.1)
API_PORT=$(cfgd api_port 9090)
API_SECRET=$(cfgd api_secret '')
DASHBOARD=$(cfgd dashboard 1)
CLASH_API=$(cfgd clash_api 0)
CLASH_PORT=$(cfgd clash_port 9091)
CLASH_SECRET=$(cfgd clash_secret '')
DASH_URL=$(cfgd dashboard_download_url '')

init_dirs() {
	mkdir -p "$INSTALL_DIR" "$BACKUP_DIR" "$CONF_DIR" "$CACHE_DIR" "$WORK_DIR" 2>/dev/null
}

# ---------- 下载器（无 curl 依赖：优先 curl，其次 OpenWrt 自带 uclient-fetch / busybox wget） ----------
dl_get() { # <url> <outfile> [timeout]
	_u="$1"; _o="$2"; _t="${3:-60}"
	if command -v curl >/dev/null 2>&1; then
		curl -fsSL --max-time "$_t" -H "User-Agent: $UA" -o "$_o" "$_u"
	elif command -v uclient-fetch >/dev/null 2>&1; then
		uclient-fetch -q -O "$_o" "$_u"
	elif command -v wget >/dev/null 2>&1; then
		wget -q -T "$_t" -O "$_o" "$_u"
	else
		return 1
	fi
}

dl_resume() { # <url> <outfile>：尽量断点续传（curl/wget 支持；uclient-fetch 则整文件重下）
	_u="$1"; _o="$2"
	if command -v curl >/dev/null 2>&1; then
		curl -fL --retry 3 --retry-delay 2 --connect-timeout 20 -C - -H "User-Agent: $UA" -o "$_o" "$_u"
	elif command -v wget >/dev/null 2>&1; then
		wget -c -q -O "$_o" "$_u"
	elif command -v uclient-fetch >/dev/null 2>&1; then
		uclient-fetch -q -O "$_o" "$_u"
	else
		return 1
	fi
}

# ---------- 架构映射：OpenWrt DISTRIB_ARCH → sing-box linux 资产后缀（优先 musl） ----------
detect_arch() {
	_a=""
	[ -f /etc/openwrt_release ] && _a=$(sed -n "s/^DISTRIB_ARCH='\(.*\)'/\1/p" /etc/openwrt_release)
	[ -n "$_a" ] || _a=$(uname -m)
	case "$_a" in
		x86_64|amd64) echo amd64-musl ;;
		i386*|i486*|i586*|i686*) echo 386-musl ;;
		aarch64*) echo arm64-musl ;;
		arm_cortex-*) echo armv7-musl ;;
		arm_arm1176*|arm_arm926*|arm_arm11*|arm_fa526|arm_xscale) echo armv6 ;;
		mipsel_*) echo mipsle-softfloat-musl ;;
		mips64el_*) echo mips64le-softfloat ;;
		mips64_*) echo mips64-softfloat ;;
		mips_*) echo mips-softfloat ;;
		riscv64_*) echo riscv64-musl ;;
		loongarch64_*) echo loong64-musl ;;
		ppc64le) echo ppc64le ;;
		*) echo "" ;;
	esac
}

FETCH_STALE=0   # 1 = 本次结果来自旧缓存（刷新失败）

# 版本号严格校验：仅接受 vX.Y.Z 或 vX.Y.Z-pre.N（拒绝把正文里的 emoji/文本当版本）
valid_tag() {
	case "$1" in
		v[0-9]*.[0-9]*.[0-9]*) ;;
		*) return 1 ;;
	esac
	case "$1" in
		*[!0-9A-Za-z.+-]*) return 1 ;;
	esac
	return 0
}

# ---------- GitHub 版本解析（无 jq，awk 状态机解析 pretty-printed JSON） ----------
# 版本来源：优先 releases.atom（约 20KB，github.com CDN），失败退回 REST API
# 解析并校验 atom 文件里的 tag（entry 的 <title> 无 v 前缀，故用 <id> 里的权威 tag）
releases_from_atom() { # <atom-file>
	[ -f "$1" ] || return 1
	_tags=$(sed -n 's#.*<id>tag:github.com,2008:Repository/[0-9]*/\(v[^<]*\)</id>.*#\1#p' "$1" | while read -r _t; do
		valid_tag "$_t" && echo "$_t"
	done)
	[ -n "$_tags" ] || return 1
	printf '%s\n' "$_tags"
}

# 只读缓存（不联网）：用于页面加载时恢复上次「检查更新」的结果
releases_cached() { releases_from_atom "$ATOM_CACHE"; }

fetch_releases_atom() { # [force]：force 跳过 TTL 检查，但失败时保留旧缓存
	_force="${1:-}"
	mkdir -p "$STATE_CACHE"
	_now=$(date +%s); _age=999999
	[ -f "$ATOM_CACHE" ] && _age=$(( _now - $(date -r "$ATOM_CACHE" +%s 2>/dev/null || echo 0) ))
	if [ "$_force" = "force" ] || [ "$_age" -gt 600 ]; then
		if dl_get "${GH_PROXY}https://github.com/$GH_REPO/releases.atom" "$ATOM_CACHE.tmp" 20 2>/dev/null; then
			mv "$ATOM_CACHE.tmp" "$ATOM_CACHE"
			FETCH_STALE=0
		else
			rm -f "$ATOM_CACHE.tmp"
			FETCH_STALE=1                      # 标记：结果来自旧缓存
			releases_from_atom "$ATOM_CACHE" || return 1
			return 0
		fi
	fi
	releases_from_atom "$ATOM_CACHE"
}

fetch_releases() { # [force]
	init_dirs
	if fetch_releases_atom "${1:-}"; then rm -f "$CACHE_DIR/releases.json"; return 0; fi
	_f="$CACHE_DIR/releases.json"
	_now=$(date +%s)
	_age=999999
	[ -f "$_f" ] && _age=$(( _now - $(date -r "$_f" +%s 2>/dev/null || echo 0) ))
	if [ "$_age" -gt 600 ]; then
		dl_get "${GH_PROXY}${GH_API}?per_page=15" "$_f.tmp" 25 2>/dev/null || { rm -f "$_f.tmp"; [ -f "$_f" ] || return 1; }
		[ -f "$_f.tmp" ] && mv "$_f.tmp" "$_f"
	fi
	[ -f "$_f" ] || return 1
	# 完整性粗检：截断的响应（未以 ] 结束）直接丢弃
	tail -c 200 "$_f" | grep -q '\]' || { rm -f "$_f"; return 1; }
	awk '
		/"tag_name":/ { gsub(/[",]/,"",$2); tag=$2 }
		/"prerelease":/ { gsub(/,/,"",$2); if (tag!="") { print tag, $2; tag="" } }
	' "$_f" | while read -r _tag _pre; do
		valid_tag "$_tag" && echo "$_tag $_pre"
	done
}

channel_match() { # <tag> <channel>
	valid_tag "$1" || return 1
	case "$2" in
		alpha) case "$1" in *-alpha.*) return 0;; esac ;;
		beta)  case "$1" in *-beta.*)  return 0;; esac ;;
		rc)    case "$1" in *-rc.*)    return 0;; esac ;;
		stable) case "$1" in *-alpha.*|*-beta.*|*-rc.*) return 1;; esac; return 0 ;;
	esac
	return 1
}

_pick_channel() { # <channel>  从 stdin 的 tag 列表里取首个匹配
	while read -r _tag _pre; do
		channel_match "$_tag" "$1" && { echo "$_tag"; break; }
	done
}

channel_latest() { # <channel>（联网）
	fetch_releases | _pick_channel "$1"
}

channel_latest_cached() { # <channel>（只读持久缓存，不联网）
	releases_cached 2>/dev/null | _pick_channel "$1"
}

channel_list() { # <channel> [limit]
	_lim=${2:-10}; _n=0
	fetch_releases | while read -r tag pre; do
		channel_match "$tag" "$1" || continue
		echo "$tag"; _n=$((_n+1)); [ "$_n" -ge "$_lim" ] && break
	done
}

# ---------- 内核安装 / 回滚 ----------
do_install() { # <channel> [pinned_tag]
	_ch="$1"; _pin="${2:-}"
	if [ -n "$_pin" ]; then _tag="$_pin"; else _tag=$(channel_latest "$_ch"); fi
	[ -n "${_tag:-}" ] || die "无法解析渠道 [$_ch] 的版本（网络或加速前缀问题）"
	_arch=$(detect_arch)
	[ -n "$_arch" ] || die "不支持的架构：$(uname -m)"
	_ver="${_tag#v}"
	_asset="sing-box-${_ver}-linux-${_arch}.tar.gz"
	_url="${GH_PROXY}https://github.com/$GH_REPO/releases/download/${_tag}/${_asset}"
	init_dirs
	_dl="$CACHE_DIR/$_asset"
	printf '[1/4] 版本 %s，架构 %s\n' "$_tag" "$_arch" >&2
	printf '[2/4] 下载 %s\n' "$_asset" >&2
	# 断点续传 + 长超时（慢链路可用）；进度与错误走 stderr，stdout 只留最终 JSON
	if ! dl_resume "$_url" "$_dl" 2>>"$CACHE_DIR/dl.err"; then
		die "下载失败：$_asset（$(tail -1 "$CACHE_DIR/dl.err" 2>/dev/null | tr -d '"')）"
	fi
	printf '[3/4] 解压与校验\n' >&2
	mkdir -p "$CACHE_DIR/x" && rm -rf "$CACHE_DIR/x"/*
	tar -xzf "$_dl" -C "$CACHE_DIR/x" || die "解压失败：$_asset"
	_bin=$(find "$CACHE_DIR/x" -type f -name sing-box | head -1)
	[ -n "$_bin" ] || die "压缩包内未找到 sing-box 可执行文件"
	chmod 0755 "$_bin" 2>/dev/null
	"$_bin" version >/dev/null 2>&1 || die "二进制无法运行（架构不匹配？）"
	# 停机 → 备份旧内核 → 安装
	_was_running=0
	pgrep -f "$CORE_PATH run" >/dev/null 2>&1 && _was_running=1
	[ "$_was_running" = 1 ] && /etc/init.d/isongwrt stop >/dev/null 2>&1
	_old=$(cat "$ACTIVE_FILE" 2>/dev/null || echo "")
	[ -n "$_old" ] && printf '%s' "$_old" > "$STATE_DIR/previous"
	cp "$_bin" "$INSTALL_DIR/sing-box-${_ver}" && chmod 0755 "$INSTALL_DIR/sing-box-${_ver}"
	cp "$_bin" "$CORE_PATH" && chmod 0755 "$CORE_PATH"
	printf '%s' "$_ver" > "$ACTIVE_FILE"
	_sha=$(sha256sum "$INSTALL_DIR/sing-box-${_ver}" 2>/dev/null | awk '{print $1}')
	printf '{"version":"%s","sha256":"%s","installed_at":"%s"}\n' "$_ver" "${_sha:-unknown}" "$(date -Is)" \
		> "$INSTALL_DIR/sing-box-${_ver}.meta"
	printf '[4/4] 安装完成并激活 %s\n' "$_ver" >&2
	rm -f "$_dl"
	[ "$_was_running" = 1 ] && /etc/init.d/isongwrt start >/dev/null 2>&1
	ok ",\"version\":\"$_ver\",\"arch\":\"$_arch\",\"restarted\":$([ "$_was_running" = 1 ] && echo true || echo false)"
}

do_activate() { # <version>
	_v="$1"
	[ -x "$INSTALL_DIR/sing-box-${_v}" ] || die "版本未安装：$_v"
	_cur=$(cat "$ACTIVE_FILE" 2>/dev/null || echo "")
	[ "$_cur" = "$_v" ] && { ok ",\"version\":\"$_v\",\"unchanged\":true"; exit 0; }
	_was_running=0
	pgrep -f "$CORE_PATH run" >/dev/null 2>&1 && _was_running=1
	[ "$_was_running" = 1 ] && /etc/init.d/isongwrt stop >/dev/null 2>&1
	[ -n "$_cur" ] && printf '%s' "$_cur" > "$STATE_DIR/previous"
	cp "$INSTALL_DIR/sing-box-${_v}" "$CORE_PATH" && chmod 0755 "$CORE_PATH"
	printf '%s' "$_v" > "$ACTIVE_FILE"
	[ "$_was_running" = 1 ] && /etc/init.d/isongwrt start >/dev/null 2>&1
	ok ",\"version\":\"$_v\""
}

do_rollback() {
	_prev=$(cat "$STATE_DIR/previous" 2>/dev/null || echo "")
	[ -n "$_prev" ] || die "没有可回滚的版本记录"
	[ -x "$INSTALL_DIR/sing-box-${_prev}" ] || die "上一版本二进制不存在：$_prev"
	_cur=$(cat "$ACTIVE_FILE" 2>/dev/null || echo "")
	_was_running=0
	pgrep -f "$CORE_PATH run" >/dev/null 2>&1 && _was_running=1
	[ "$_was_running" = 1 ] && /etc/init.d/isongwrt stop >/dev/null 2>&1
	cp "$INSTALL_DIR/sing-box-${_prev}" "$CORE_PATH" && chmod 0755 "$CORE_PATH"
	printf '%s' "$_prev" > "$ACTIVE_FILE"
	[ -n "$_cur" ] && printf '%s' "$_cur" > "$STATE_DIR/previous"
	[ "$_was_running" = 1 ] && /etc/init.d/isongwrt start >/dev/null 2>&1
	ok ",\"version\":\"$_prev\""
}

do_remove() { # <version> [force]
	_v="$1"; _force="${2:-}"
	[ -x "$INSTALL_DIR/sing-box-${_v}" ] || die "版本未安装：$_v"
	_cur=$(cat "$ACTIVE_FILE" 2>/dev/null || echo "")

	if [ "$_v" = "$_cur" ]; then
		# 删除当前激活版本：需 force（面板会先弹确认）
		[ "$_force" = "force" ] || die "不能删除当前激活版本（面板中删除会先确认；或先「激活」其它版本）"
		_was_running=0
		pgrep -f "$CORE_PATH run" >/dev/null 2>&1 && _was_running=1
		[ "$_was_running" = 1 ] && /etc/init.d/isongwrt stop >/dev/null 2>&1
		rm -f "$INSTALL_DIR/sing-box-${_v}" "$INSTALL_DIR/sing-box-${_v}.meta"
		rm -f "$ACTIVE_FILE"
		_prev=$(cat "$STATE_DIR/previous" 2>/dev/null || echo "")
		[ "$_v" = "$_prev" ] && rm -f "$STATE_DIR/previous"
		# 若还有其它版本，自动激活最新的一版
		_next=$(ls -1 "$INSTALL_DIR"/sing-box-* 2>/dev/null | grep -v '\.meta$' | sort -V | tail -1)
		if [ -n "$_next" ]; then
			_nv=${_next##*/sing-box-}
			cp "$_next" "$CORE_PATH" && chmod 0755 "$CORE_PATH"
			printf '%s' "$_nv" > "$ACTIVE_FILE"
			[ "$_was_running" = 1 ] && /etc/init.d/isongwrt start >/dev/null 2>&1
			ok ",\"removed\":\"$_v\",\"activated\":\"$_nv\""
		else
			rm -f "$CORE_PATH" "$STATE_DIR/previous"
			ok ",\"removed\":\"$_v\",\"activated\":null,\"note\":\"已无可用内核，服务将无法启动\""
		fi
		return 0
	fi

	# 非激活版本：直接删除
	rm -f "$INSTALL_DIR/sing-box-${_v}" "$INSTALL_DIR/sing-box-${_v}.meta"
	_prev=$(cat "$STATE_DIR/previous" 2>/dev/null || echo "")
	[ "$_v" = "$_prev" ] && rm -f "$STATE_DIR/previous"
	ok ",\"removed\":\"$_v\""
}

# ---------- 后台安装（Web 面板用：避免慢链路阻塞请求） ----------
INSTALL_LOG="$CACHE_DIR/install.log"
INSTALL_LOCK="$CACHE_DIR/install.lock"

do_install_bg() { # <channel> [tag]
	_ch="$1"; _pin="${2:-}"
	init_dirs
	if [ -f "$INSTALL_LOCK" ] && kill -0 "$(cat "$INSTALL_LOCK" 2>/dev/null)" 2>/dev/null; then
		die "已有安装任务正在进行（可查看进度）"
	fi
	rm -f "$INSTALL_LOCK"
	: > "$INSTALL_LOG"
	# busybox 无 nohup：子 shell 后台 + 重定向即可（无控制终端，父进程退出不影响）
	( /usr/lib/isongwrt/ctl install "$_ch" "$_pin" >> "$INSTALL_LOG" 2>&1 & echo $! > "$INSTALL_LOCK" )
	sleep 1
	ok ",\"pid\":$(cat "$INSTALL_LOCK" 2>/dev/null || echo 0)"
}

do_install_status() {
	_running=false
	if [ -f "$INSTALL_LOCK" ] && kill -0 "$(cat "$INSTALL_LOCK" 2>/dev/null)" 2>/dev/null; then
		_running=true
	fi
	_state=idle
	if grep -q '"ok":true' "$INSTALL_LOG" 2>/dev/null; then
		_state=done; _running=false
	elif grep -q '"ok":false' "$INSTALL_LOG" 2>/dev/null; then
		_state=failed; _running=false
	elif [ "$_running" = true ]; then
		_state=running
	fi
	_size=$(wc -c < "$INSTALL_LOG" 2>/dev/null | tr -d ' ')
	printf '{"ok":true,"running":%s,"state":"%s","log":"' "$_running" "$_state"
	tail -c 3000 "$INSTALL_LOG" 2>/dev/null | json_ml
	printf '"}\n'
}

# 为配置里的 remote rule_set 注入 download_detour（解决国内直连 GitHub 下载失败导致启动失败）
# 用法：conf-fix-remote <name> [outbound-tag]
do_conf_fix_remote() {
	_name="$1"; _tag="${2:-}"
	case "$_name" in */*|*..*) die "非法文件名";; esac
	_f="$CONF_DIR/$_name.json"
	[ -f "$_f" ] || die "配置文件不存在：$_name.json"

	_n_remote=$(grep -c '"type": "remote"' "$_f" 2>/dev/null || echo 0)
	[ "$_n_remote" -gt 0 ] || die "该配置没有 remote 类型的 rule_set，无需修复"
	_n_detour=$(grep -c 'download_detour' "$_f" 2>/dev/null || echo 0)
	[ "$_n_detour" -ge "$_n_remote" ] && die "已全部包含 download_detour（$_n_detour/$_n_remote），无需修复"

	# 新版写法：http_clients 里定义带 detour 的客户端，rule_set 用 http_client 引用；
	# 若配置里已有 http_clients（不便自动改写数组），退回旧的 download_detour（可用但会告警）
	_modern=1
	grep -q '"http_clients"' "$_f" && _modern=0

	# 推断代理出站：参数 → route.final（若为代理）→ 第一个非直连出站
	if [ -z "$_tag" ]; then
		_tag=$(grep -o '"final": "[^"]*"' "$_f" | tail -1 | sed 's/.*: "//; s/"$//')
		case "$_tag" in ""|direct|DIRECT) _tag="" ;; esac
	fi
	if [ -z "$_tag" ]; then
		_tag=$(grep -o '"tag": "[^"]*"' "$_f" | sed 's/.*: "//; s/"$//' | grep -viE '^(direct|DIRECT|block|dns-|.*-in|mixed-in)$' | head -1)
	fi
	[ -n "$_tag" ] || die "未找到可用作下载代理的出站，请指定：conf-fix-remote $_name <出站标签>"

	init_dirs
	_bak="$BACKUP_DIR/${_name}-detour-$(date +%Y%m%d-%H%M%S).json"
	mkdir -p "$BACKUP_DIR"; cp "$_f" "$_bak" || die "备份失败"

	# 逐行插入（保持缩进与注释不动）
	if [ "$_modern" = "1" ]; then
		# 1) 顶层插入 http_clients 定义（放在 route 之前）
		awk -v tag="$_tag" '
			BEGIN { done = 0 }
			{
				if (done == 0 && $0 ~ /^  "route"[ ]*:[ ]*\{/) {
					print "  \"http_clients\": [ { \"tag\": \"isongwrt-download\", \"detour\": \"" tag "\" } ],"
					done = 1
				}
				print
			}
			END {
				if (done == 0) exit 3
			}
		' "$_f" > "$_f.new" || { rm -f "$_f.new"; _modern=0; }
		[ "$_modern" = "1" ] && mv "$_f.new" "$_f"
		# 2) 给缺引用字段的 remote rule_set 补 http_client
		awk -v key='"http_client"' '
			BEGIN { pending = 0 }
			{
				if (pending == 1) {
					if ($0 ~ /http_client|download_detour/) { print; pending = 0; next }
					print indent key ": \"isongwrt-download\","
					pending = 0; print; next
				}
				print
				if ($0 ~ /"type": *"remote",/) {
					match($0, /^[ \t]*/); indent = substr($0, 1, RLENGTH); pending = 1
				}
			}
		' "$_f" > "$_f.new" && mv "$_f.new" "$_f"
	fi
	if [ "$_modern" = "0" ]; then
		# 回退：旧的 download_detour（sing-box 会给出弃用告警，但功能正常）
		awk -v tag="$_tag" '
			BEGIN { pending = 0 }
			{
				if (pending == 1) {
					if ($0 ~ /download_detour/) { print; pending = 0; next }
					print indent "\"download_detour\": \"" tag "\","
					pending = 0; print; next
				}
				print
				if ($0 ~ /"type": *"remote",/) {
					match($0, /^[ \t]*/); indent = substr($0, 1, RLENGTH); pending = 1
				}
			}
		' "$_f" > "$_f.new" && mv "$_f.new" "$_f"
	fi

	if _e=$(CONF_CHECK 2>&1); then
		ok ",\"patched\":\"$_name.json\",\"detour\":\""$_tag"\",\"backup\":\"$(json_esc "$_bak")\""
	else
		cp "$_bak" "$_f"
		die "注入后配置校验失败，已回滚：$(printf '%s' "$_e" | tail -2 | tr '\n' ' ')"
	fi
}

# ---------- 配置管理 ----------
CONF_CHECK() { # 返回 0/1，并输出错误文本
	if [ ! -x "$CORE_PATH" ]; then
		printf '%s' "尚未安装 sing-box 内核（先到「内核管理」安装）" >&2; return 1
	fi
	_out=$("$CORE_PATH" check -D "$WORK_DIR" -C "$CONF_DIR" 2>&1); _rc=$?
	[ "$_rc" = 0 ] && return 0
	printf '%s' "$_out" >&2; return 1
}

do_config_save() { # <name> [file]  内容来自 file，缺省从 stdin 读取
	_name="$1"; _src="${2:-}"; init_dirs
	case "$_name" in */*|*..*) die "非法文件名";; esac
	_tmp="$CACHE_DIR/upload-$$.json"
	if [ -n "$_src" ]; then
		[ -f "$_src" ] || die "内容文件不存在：$_src"
		cp "$_src" "$_tmp" || die "读取内容文件失败"
	else
		cat > "$_tmp" || die "读取上传内容失败"
	fi
	[ -s "$_tmp" ] || die "内容为空（请先在上方编辑或选择文件）"
	_target="$CONF_DIR/${_name}.json"
	_bak="$BACKUP_DIR/${_name}-$(date +%Y%m%d-%H%M%S).json"
	[ -f "$_target" ] && cp "$_target" "$_bak"
	cp "$_tmp" "$_target"
	if ! _err=$(CONF_CHECK 2>&1); then
		[ -f "$_bak" ] && cp "$_bak" "$_target" || rm -f "$_target"
		rm -f "$_tmp"
		die "配置校验未通过，已回退：$(printf '%s' "$_err" | tail -3 | tr '\n' ' ')"
	fi
	rm -f "$_tmp"
	ok ",\"file\":\"$(json_esc "$_target")\""
}

do_config_restore() { # <backup-file>
	_b="$1"
	case "$_b" in */*|*..*) die "非法文件名";; esac
	[ -f "$BACKUP_DIR/$_b" ] || die "备份不存在：$_b"
	_name=$(printf '%s' "$_b" | sed 's/-[0-9]\{8\}-[0-9]\{6\}\.json$//')
	cp "$BACKUP_DIR/$_b" "$CONF_DIR/${_name}.json" || die "恢复失败"
	if ! _err=$(CONF_CHECK 2>&1); then
		die "恢复后的配置校验未通过：$(printf '%s' "$_err" | tail -2 | tr '\n' ' ')"
	fi
	ok ",\"restored\":\"$_name\""
}

do_config_get() { # <name>
	_f="$CONF_DIR/${1:?}.json"
	[ -f "$_f" ] || die "配置不存在：${1}"
	printf '{"ok":true,"name":"%s","content":"' "$(json_esc "${1}")"
	json_ml < "$_f"
	printf '"}\n'
}

do_config_list() {
	init_dirs
	printf '{"ok":true,"conf_dir":"%s","files":[' "$(json_esc "$CONF_DIR")"
	_first=1
	for f in "$CONF_DIR"/*.json; do
		[ -f "$f" ] || continue
		[ "$_first" = 1 ] || printf ','
		_first=0
		printf '{"name":"%s","size":%s}' "$(basename "$f" .json)" "$(wc -c < "$f" | tr -d ' ')"
	done
	printf '],"backups":['
	_first=1
	for f in "$BACKUP_DIR"/*.json; do
		[ -f "$f" ] || continue
		[ "$_first" = 1 ] || printf ','
		_first=0
		printf '"%s"' "$(basename "$f")"
	done
	printf ']}\n'
}

do_api_secret_new() {
	_new=$(head -c 32 /dev/urandom | md5sum | cut -c1-24)
	if uci -q set isongwrt.main.api_secret="$_new" && uci -q commit isongwrt; then
		ok ",\"secret\":\"$_new\""
	else
		die "写入 UCI 失败"
	fi
}

# ---------- API / 面板托管（独立分片文件，避免改动用户配置） ----------
do_api_sync() {
	init_dirs
	_f="$CONF_DIR/90-isongwrt-api.json"

	# ---------- 检测「上传配置」里已定义的方案（面板只补缺，绝不覆盖） ----------
	_u_api=false; _u_clash=false; _u_http_tag=""
	for _cf in "$CONF_DIR"/*.json; do
		case "$_cf" in *90-isongwrt-api.json) continue ;; esac
		[ -f "$_cf" ] || continue
		grep -q '"type": *"api"' "$_cf" 2>/dev/null && _u_api=true
		grep -q '"clash_api"' "$_cf" 2>/dev/null && _u_clash=true
		if [ -z "$_u_http_tag" ]; then
			_u_http_tag=$(sed -n 's/.*"default_http_client": *"\([^"]*\)".*/\1/p' "$_cf" 2>/dev/null | head -1)
			[ -n "$_u_http_tag" ] || _u_http_tag=$(sed -n '/"http_clients"/,/]/p' "$_cf" 2>/dev/null | sed -n 's/.*"tag": *"\([^"]*\)".*/\1/p' | head -1)
		fi
	done

	_clash_src=none; [ "$_u_clash" = true ] && _clash_src=config
	_need_api=$DASHBOARD
	_need_clash=false
	[ "$CLASH_API" = 1 ] && [ "$_u_clash" = false ] && _need_clash=true
	_clash_src_panel=false; [ "$_need_clash" = true ] && _clash_src_panel=true

	# 配置里已有 API 服务 → 面板完全不注入
	if [ "$_u_api" = true ]; then
		[ -f "$_f" ] && rm -f "$_f"
		_write_source config "$_clash_src"
		ok ",\"api_file\":null,\"api_source\":\"config\",\"clash_source\":\"$_clash_src\",\"note\":\"配置已自带 API 服务，面板未注入任何分片\""
		return 0
	fi

	# 面板不需要注入任何东西 → 清掉历史分片
	if [ "$_need_api" != 1 ] && [ "$_need_clash" != true ]; then
		[ -f "$_f" ] && rm -f "$_f"
		_write_source none "$_clash_src"
		ok ",\"api_file\":null,\"api_source\":\"none\",\"clash_source\":\"$_clash_src\""
		return 0
	fi

	# 访问密钥：仅面板自己写 api 服务时才需要（默认自动生成并写回 UCI）
	if [ "$_need_api" = 1 ] && [ -z "$API_SECRET" ]; then
		API_SECRET=$(head -c 32 /dev/urandom | md5sum | cut -c1-24)
		uci -q set isongwrt.main.api_secret="$API_SECRET" >/dev/null 2>&1 && uci -q commit isongwrt >/dev/null 2>&1
		printf '[api-sync] 已自动生成访问密钥\n' >&2
	fi
	[ -n "$API_LISTEN" ] || API_LISTEN=0.0.0.0

	# http client：配置里已有就复用其 tag（不重复定义 http_clients，避免与用户配置打架）
	_http_line=""; _dash_client="isongwrt-dashboard"
	if [ "$_need_api" = 1 ]; then
		if [ -n "$_u_http_tag" ]; then
			_dash_client="$_u_http_tag"
		else
			_http_line='  "http_clients": [ { "tag": "isongwrt-dashboard" } ],'
		fi
	fi

	{
		printf '{\n'
		[ -n "$_http_line" ] && printf '%s\n' "$_http_line"
		if [ "$_need_api" = 1 ]; then
			printf '  "services": [\n    {\n      "type": "api",\n      "tag": "isongwrt-api",\n'
			printf '      "listen": "%s",\n      "listen_port": %s,\n' "$API_LISTEN" "$API_PORT"
			[ -n "$API_SECRET" ] && printf '      "secret": "%s",\n' "$(json_esc "$API_SECRET")"
			printf '      "access_control_allow_private_network": true,\n'
			if [ -n "$DASH_URL" ]; then
				printf '      "dashboard": { "enabled": true, "update_interval": "1d", "http_client": "%s", "download_url": "%s" }\n' "$_dash_client" "$(json_esc "$DASH_URL")"
			else
				printf '      "dashboard": { "enabled": true, "update_interval": "1d", "http_client": "%s" }\n' "$_dash_client"
			fi
			if [ "$_need_clash" = true ]; then printf '    }\n  ],\n'; else printf '    }\n  ]\n'; fi
		fi
		if [ "$_need_clash" = true ]; then
			printf '  "experimental": {\n    "clash_api": {\n      "external_controller": "%s:%s"' "$API_LISTEN" "$CLASH_PORT"
			[ -n "$CLASH_SECRET" ] && printf ',\n      "secret": "%s"' "$(json_esc "$CLASH_SECRET")"
			printf '\n    }\n  }\n'
		fi
		printf '}\n'
	} > "$_f"

	if ! _err=$(CONF_CHECK 2>&1); then
		rm -f "$_f"
		_write_source none none
		die "生成 API 分片失败（与配置冲突？）：$(printf '%s' "$_err" | tail -2 | tr '\n' ' ')"
	fi

	_panel_api=none; [ "$_need_api" = 1 ] && _panel_api=panel
	[ "$_need_clash" = true ] && _clash_src=panel
	_write_source "$_panel_api" "$_clash_src"
	_busy=""
	if [ "$_need_api" = 1 ] && netstat -tln 2>/dev/null | grep -q ":$API_PORT "; then
		pgrep -f "$CORE_PATH run" >/dev/null 2>&1 || _busy="（注意：端口 $API_PORT 已被其它程序占用，服务可能启动失败）"
	fi
	ok ",\"api_file\":\"$(json_esc "$_f")\",\"api_source\":\"$_panel_api\",\"clash_source\":\"$_clash_src\",\"warning\":\"$_busy\""
}

# 记录「API/clash 由谁提供」，供状态页展示
_write_source() {
	printf 'api_source=%s\nclash_source=%s\n' "$1" "$2" > "$STATE_DIR/api-source" 2>/dev/null
}

# ---------- 状态 / 日志 / 服务 ----------
do_status() {
	_running=false; _pid=""
	_p=$(pgrep -f "$CORE_PATH run" 2>/dev/null | head -1)
	[ -n "$_p" ] && { _running=true; _pid="$_p"; }
	_ver=""
	[ -x "$CORE_PATH" ] && _ver=$("$CORE_PATH" version 2>/dev/null | head -1 | awk '{print $3}')
	_enabled=false
	[ "$(cfgd enabled 0)" = "1" ] && _enabled=true
	_core_installed=false
	[ -x "$CORE_PATH" ] && _core_installed=true
	_chk=n/a
	if [ "$_core_installed" = true ]; then
		_chk=ok
		CONF_CHECK >/dev/null 2>&1 || _chk=fail
	fi
	_nfiles=$(ls "$CONF_DIR"/*.json 2>/dev/null | wc -l | tr -d ' ')
	_port_busy=false
	if netstat -tln 2>/dev/null | grep -q ":$API_PORT "; then
		# 若占用者不是本服务（未运行时），视为冲突
		[ "$_running" = false ] && _port_busy=true
	fi

	# API/clash 由谁提供（api-sync 写入；config = 上传配置自带，panel = 面板注入）
	_api_src=none; _clash_src=none
	if [ -f "$STATE_DIR/api-source" ]; then
		_api_src=$(sed -n 's/^api_source=//p' "$STATE_DIR/api-source" | head -1)
		_clash_src=$(sed -n 's/^clash_source=//p' "$STATE_DIR/api-source" | head -1)
		[ -n "$_api_src" ] || _api_src=none
		[ -n "$_clash_src" ] || _clash_src=none
	fi

	# 配置内冲突：用户配置里的 clash_api/入站 若与面板 API 端口相同，内核会启动成功后立刻 FATAL 退出
	_api_conflict=false
	for _cf in "$CONF_DIR"/*.json; do
		[ -f "$_cf" ] || continue
		case "$_cf" in *90-isongwrt-api.json) continue ;; esac
		if grep -qE '\"external_controller\": *\"[^\"]*:'"$API_PORT"'\"' "$_cf" 2>/dev/null; then
			_api_conflict=true; break
		fi
		if grep -qE '\"listen_port\": *'"$API_PORT"'([^0-9]|$)' "$_cf" 2>/dev/null; then
			_api_conflict=true; break
		fi
	done
	printf '{"ok":true,"running":%s,"pid":"%s","enabled":%s,"version":"%s","active":"%s","core_installed":%s,"channel":"%s","arch":"%s","core_path":"%s","conf_dir":"%s","conf_files":%s,"api":"%s:%s","api_port_busy":%s,"api_port_conflict":%s,"dashboard":%s,"clash_api":%s,"config_check":"%s","api_source":"%s","clash_source":"%s"}\n' \
		"$_running" "$_pid" "$_enabled" "$(json_esc "$_ver")" "$(cat "$ACTIVE_FILE" 2>/dev/null)" "$_core_installed" \
		"$CHANNEL" "$(detect_arch)" "$(json_esc "$CORE_PATH")" "$(json_esc "$CONF_DIR")" "$_nfiles" \
		"$API_LISTEN" "$API_PORT" "$_port_busy" "$_api_conflict" "$([ "$DASHBOARD" = 1 ] && echo true || echo false)" \
		"$([ "$CLASH_API" = 1 ] && echo true || echo false)" "$_chk" "$_api_src" "$_clash_src"
}

do_installed() {
	printf '{"ok":true,"active":"%s","previous":"%s","versions":[' \
		"$(cat "$ACTIVE_FILE" 2>/dev/null)" "$(cat "$STATE_DIR/previous" 2>/dev/null)"
	_first=1
	for f in "$INSTALL_DIR"/sing-box-*; do
		case "$f" in *.meta) continue;; esac
		[ -f "$f" ] || continue
		[ "$_first" = 1 ] || printf ','
		_first=0
		_v=${f##*/sing-box-}
		_meta="$INSTALL_DIR/sing-box-${_v}.meta"
		_sha=$(sed -n 's/.*"sha256":"\([^"]*\)".*/\1/p' "$_meta" 2>/dev/null)
		printf '{"version":"%s","sha256":"%s","size":%s}' "$_v" "$_sha" "$(wc -c < "$f" | tr -d ' ')"
	done
	printf ']}\n'
}

do_log() {
	_n=${1:-200}
	_esc=$(printf '\033')
	printf '{"ok":true,"log":"'
	# 去掉 ANSI 颜色序列与其余控制字符：raw 控制字符会让 JSON 非法，前端 JSON.parse 直接失败（页面空白）
	logread 2>/dev/null | grep -E 'isongwrt|sing-box' | tail -n "$_n" \
		| sed "s/${_esc}\[[0-9;]*[A-Za-z]//g" \
		| tr -d '\000-\010\013\014\016-\037' \
		| json_ml
	printf '"}\n'
}

do_channels() {
	_mode="${1:-}"

	# cached：只读上次结果（页面加载用，不联网、不报错）
	if [ "$_mode" = "cached" ]; then
		if ! releases_cached >/dev/null 2>&1; then
			printf '{"ok":true,"cached":false,"channels":[]}\n'
			return 0
		fi
		_ts=$(date -r "$ATOM_CACHE" +%s 2>/dev/null || echo 0)
		printf '{"ok":true,"cached":true,"fetched_at":%s,"fetched_at_text":"%s","channels":[' \
			"${_ts:-0}" "$(date -r "$ATOM_CACHE" '+%Y-%m-%d %H:%M' 2>/dev/null)"
		_first=1
		for c in stable rc beta alpha; do
			_latest=$(channel_latest_cached "$c")
			[ "$_first" = 1 ] || printf ','
			_first=0
			printf '{"name":"%s","latest":"%s"}' "$c" "$_latest"
		done
		printf ']}\n'
		return 0
	fi

	# force = 跳过缓存 TTL 强制重新拉取（“检查更新”按钮）；
	# 注意：不清除旧缓存——若刷新失败，页面上仍能显示上次结果
	if ! fetch_releases "$_mode" >/dev/null 2>&1; then
		die "无法获取版本列表（GitHub 不可达或被限速，可在「内核管理」页填写加速前缀）"
	fi
	_stale=false
	[ "$FETCH_STALE" = "1" ] && _stale=true
	printf '{"ok":true,"refreshed":%s,"stale":%s' "$([ "$_stale" = true ] && echo false || echo true)" "$_stale"
	printf ',"fetched_at_text":"%s"' "$(date -r "$ATOM_CACHE" '+%Y-%m-%d %H:%M' 2>/dev/null)"
	[ "$_stale" = true ] && printf ',"warning":"刷新失败，以下为上次结果"'
	printf ',"channels":['
	_first=1
	for c in stable rc beta alpha; do
		_latest=$(channel_latest_cached "$c")
		[ "$_first" = 1 ] || printf ','
		_first=0
		printf '{"name":"%s","latest":"%s"}' "$c" "$_latest"
	done
	printf ']}\n'
}

case "${1:-status}" in
	status)      do_status ;;
	channels)    do_channels "${2:-}" ;;
	releases)    { printf '{"ok":true,"channel":"%s","releases":[' "${2:-stable}"; _f=1
	              for _r in $(channel_list "${2:-stable}" "${3:-12}"); do
	                [ "$_f" = 1 ] || printf ','; _f=0; printf '"%s"' "$_r"
	              done; printf ']}\n'; } ;;
	installed)   do_installed ;;
	install)     do_install "${2:-stable}" "${3:-}" ;;
	install-bg)     do_install_bg "${2:-stable}" "${3:-}" ;;
	install-status) do_install_status ;;
	activate)    do_activate "${2:?}" ;;
	rollback)    do_rollback ;;
	remove)      do_remove "${2:?}" "${3:-}" ;;
	config-list)    do_config_list ;;
	config-get)     do_config_get "${2:?}" ;;
	config-save)    do_config_save "${2:?}" "${3:-}" ;;
	config-restore) do_config_restore "${2:?}" ;;
	conf-fix-remote) do_conf_fix_remote "${2:?}" "${3:-}" ;;
	config-backup)  mkdir -p "$BACKUP_DIR"; _d="$BACKUP_DIR/snapshot-$(date +%Y%m%d-%H%M%S)"; mkdir -p "$_d"; cp "$CONF_DIR"/*.json "$_d/" 2>/dev/null; ok ",\"snapshot\":\"$(json_esc "$_d")\"" ;;
	api-sync)    do_api_sync ;;
	api-secret-new) do_api_secret_new ;;
	check)       if _e=$(CONF_CHECK 2>&1); then ok; else die "$(printf '%s' "$_e" | tail -3 | tr '\n' ' ')"; fi ;;
	log)         do_log "${2:-200}" ;;
	service)     case "${2:-}" in
			start|stop|restart)
				# 标记为手动启动（不受 UCI enabled=0 限制）
				ISONGWRT_MANUAL_START=1 /etc/init.d/isongwrt "$2" >/dev/null 2>&1 || die "服务操作失败：$2"
				if [ "$2" = "stop" ] || [ "$2" = "restart" ]; then
					# procd 优雅退出最长 5s，等待进程真正结束再回报
					_j=0
					while [ "$_j" -lt 6 ] && pgrep -f "$CORE_PATH run" >/dev/null 2>&1; do
						sleep 1; _j=$((_j + 1))
					done
					pkill -f "$CORE_PATH run" >/dev/null 2>&1
				fi
				case "$2" in
					start|restart)
						# 规则集/面板资源可能需要下载，最多等 8 秒
						_i=0
						while [ "$_i" -lt 4 ]; do
							pgrep -f "$CORE_PATH run" >/dev/null 2>&1 && break
							sleep 2; _i=$((_i + 1))
						done
						if ! pgrep -f "$CORE_PATH run" >/dev/null 2>&1; then
							# 只取真正的失败原因：优先 FATAL/ERROR，跳过 INFO 噪音
							_err=$(logread 2>/dev/null | grep -iE 'sing-box\[[0-9]+\]' | grep -iE 'FATAL|ERROR' | tail -2 | sed 's/.*sing-box\[[0-9]*\]: //' | tr '\n' ' ')
							_hint=""
							if printf '%s' "$_err" | grep -qiE 'address already in use|bind:'; then
								_hint="（端口被占用：请到「面板」页改用其它 API 端口，并检查入站端口是否与 mihomo 等冲突）"
							elif printf '%s' "$_err" | grep -qiE 'download|http2|rule.?set'; then
								_hint="（疑似远端规则集下载失败：可在「配置管理」点「规则集走代理」为 rule_set 指定下载走代理）"
							fi
							[ -n "$_err" ] || _err="未发现 FATAL/ERROR 日志；请检查「开机自启」是否关闭、配置是否为空、内核是否已安装"
							die "服务未能启动：${_err}${_hint}"
						fi ;;
				esac
				ok ",\"action\":\"$2\"" ;;
			enable|disable) /etc/init.d/isongwrt "$2" >/dev/null 2>&1 && ok || die "服务操作失败：$2" ;;
			*) die "service 需要 start|stop|restart|enable|disable" ;;
		esac ;;
	*) die "未知命令：${1:-}" ;;
esac
