config isongwrt 'main'
	option enabled '0'
	# 内核与配置路径
	option core_path '/usr/lib/isongwrt/sing-box'
	option conf_dir '/etc/isongwrt/conf'
	option work_dir '/etc/isongwrt'
	# 内核渠道：stable | rc | beta | alpha
	option channel 'stable'
	# GitHub 加速前缀（可选，例：https://ghfast.top/）
	option github_proxy ''
	# 内核版本（留空 = 渠道最新；也可填精确 tag）
	option pin_version ''
	# API 服务与官方面板（sing-box 1.14+；面板经 /dashboard/ 自动下载托管）
	# 监听地址固定 0.0.0.0（允许局域网访问面板）；访问密钥由安装脚本自动生成
	option api_listen '0.0.0.0'
	option api_port '9090'
	option api_secret ''
	option dashboard '1'
	# 面板资源下载地址（留空 = 官方默认 gh-pages zip；CN 可填镜像）
	option dashboard_download_url ''
	# Only the native sing-box API service above is supported; the former
	# clash_api / clash_port / clash_secret keys are deleted by
	# /etc/uci-defaults/99-isongwrt on upgrade.
