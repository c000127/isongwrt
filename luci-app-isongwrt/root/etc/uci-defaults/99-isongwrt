#!/bin/sh
# isongwrt 首次安装初始化
mkdir -p /etc/isongwrt/conf /etc/isongwrt/installed /etc/isongwrt/backups

# 无配置时放置最小可用模板（可直接在面板里上传替换）
if ! ls /etc/isongwrt/conf/*.json >/dev/null 2>&1; then
	cat > /etc/isongwrt/conf/10-user.json <<'SAMPLE'
{
  "log": { "level": "info", "timestamp": true },
  "dns": {
    "servers": [ { "type": "local", "tag": "dns-local" } ],
    "final": "dns-local"
  },
  "inbounds": [
    { "type": "tun", "tag": "tun-in", "address": ["172.19.0.1/30"],
      "auto_route": true, "strict_route": true }
  ],
  "outbounds": [ { "type": "direct", "tag": "direct" } ],
  "http_clients": [ { "tag": "default" } ],
  "route": { "final": "direct", "default_http_client": "default" }
}
SAMPLE
fi

# 默认访问密钥（面板与 API 用；可在面板页重新生成）
if [ -z "$(uci -q get isongwrt.main.api_secret)" ]; then
	uci set isongwrt.main.api_secret="$(head -c 32 /dev/urandom | md5sum | cut -c1-24)"
	uci commit isongwrt
fi

# Migration: drop the legacy Clash API keys. The Clash API is no longer part of
# this app — only the native sing-box API service is generated (see ctl api-sync).
# /etc/config/isongwrt is a conffile, so an upgrade may keep the old keys around.
_legacy=0
for _key in clash_api clash_port clash_secret; do
	if uci -q get "isongwrt.main.$_key" >/dev/null 2>&1; then
		uci -q delete "isongwrt.main.$_key" && _legacy=1
	fi
done
[ "$_legacy" = "1" ] && uci -q commit isongwrt

# 建立开机启动链接：实际是否随系统启动由 UCI 的 enabled 决定（见 init 脚本）
/etc/init.d/isongwrt enable 2>/dev/null

# 依据当前 UCI 生成 API/面板分片
/usr/lib/isongwrt/ctl api-sync >/dev/null 2>&1
exit 0
